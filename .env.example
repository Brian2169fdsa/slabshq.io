# ─────────────────────────────────────────────────────────────
# SlabHQ — environment contract (per FRONTEND_INTEGRATION.md)
# Copy to .env.local (gitignored) and fill in the two keys.
# NEVER commit real keys. .env*.local is in .gitignore.
# ─────────────────────────────────────────────────────────────

# PUBLIC — safe in the browser (anon key is RLS-gated; returns 0 rows
# on direct table reads until end-user auth lands — that's expected).
NEXT_PUBLIC_SUPABASE_URL=https://savlmwcjipskbowgrtrc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY — must NEVER reach client code or the browser bundle.
# No NEXT_PUBLIC_ prefix => Next.js will not expose it. Reads/writes run
# server-side with this key, scoped by tenant_id (RLS bypass + manual scope).
SUPABASE_SERVICE_ROLE_KEY=

# Demo tenant (hardcoded until Supabase Auth derives it from the session).
# Default matches the guide; override only if needed.
DEMO_TENANT_ID=00000000-0000-0000-0000-000000000001

# Edge functions base. Defaults to <SUPABASE_URL>/functions/v1 if unset.
SUPABASE_FUNCTIONS_URL=
